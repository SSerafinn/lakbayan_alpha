rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for content assets; writes handled by admins/functions.
    // Tighten write with custom claims (request.auth.token.admin == true) once set up.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
