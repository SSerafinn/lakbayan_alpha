{
  "$schema": "https://design-tokens.org/draft",
  "meta": {
    "name": "Lakbayan",
    "description": "Design tokens for Lakbayan, the self-guided tourism companion for the Province of Cagayan. The app (3.0.0): emerald, ink, paper and pastels; white cards on a paper page, warm charcoal in the dark. The CMS (2.3.0): white ground, green signature, gold FEATURED.",
    "platform": "Android-first, Flutter / Material 3",
    "version": "3.0.0",
    "source": "Design system 3.0.0 (D-19) for the app, 2.3.0 (D-13, D-15, D-16) for the CMS. Values are recorded here; the reasoning is restated for the team in docs/DESIGN_SYSTEM.md. lib/core/theme/*.dart transcribes app.*, shape.* and size.*; cms/src/styles/tokens.css is generated by cms/scripts/gen-tokens.mjs from every other group, which is why the 3.0 values live under app.* and the CMS look does not move with the app. Change it here first."
  },
  "app": {
    "$comment": "3.0.0 (D-19). The mobile app only; the CMS generator does not read this group. Paper is the page, a card is white on it, and what sits inside a card takes paper again. Colour does one job each: emerald for the primary action, selection, links and focus; pastels for a kind and the brand's quiet moments, never a button; red for the saved heart and destructive words; blue for the route and your own position.",
    "font": {
      "body": { "$value": "Satoshi", "$type": "fontFamily", "$description": "every word a person reads in the UI; 550 to read, 650 for labels, never below 550" },
      "heading": { "$value": "CabinetGrotesk", "$type": "fontFamily", "$description": "headings at 700 and 800; variable, wght 100-900, Fontshare FFL" },
      "brand": { "$value": "Barabara", "$type": "fontFamily", "$description": "the LAKBAYAN wordmark and the landing greetings only; uppercase only" }
    },
    "light": {
      "page": { "$value": "#F3F2EE", "$type": "color", "$description": "paper: the scaffold, sheets, and what sits inside a card (surface, surfaceContainerLow)" },
      "card": { "$value": "#FFFFFF", "$type": "color", "$description": "a card, a grouped section, the tab bar, a control on the page (surfaceContainerLowest)" },
      "container": { "$value": "#ECEBE6", "$type": "color" },
      "containerHigh": { "$value": "#E5E3DC", "$type": "color", "$description": "a floating menu, a media placeholder" },
      "containerHighest": { "$value": "#DEDCD4", "$type": "color", "$description": "an image placeholder, a disabled fill" },
      "glass": { "$value": "#FFFFFFE6", "$type": "color", "$description": "a control over a photo or a map; opaque, no blur" },
      "ink": { "$value": "#1B1B19", "$type": "color", "$description": "15.5:1 on paper" },
      "sub": { "$value": "#6B6A64", "$type": "color", "$description": "second lines, 4.9:1 on paper" },
      "outline": { "$value": "#9E9C95", "$type": "color" },
      "line": { "$value": "#E5E3DC", "$type": "color", "$description": "the hairline: a chip, an outlined badge, a field, the secondary button. Never a divider." },
      "primary": { "$value": "#00755A", "$type": "color", "$description": "jade emerald; white on it 5.7:1" },
      "onPrimary": { "$value": "#FFFFFF", "$type": "color" },
      "primaryText": { "$value": "#005C45", "$type": "color", "$description": "emerald words and links, 6.9:1 on paper" },
      "tint": { "$value": "#E2F3EB", "$type": "color", "$description": "pressed states only, never a content fill" },
      "spatial": { "$value": "#1F6FD1", "$type": "color", "$description": "the route and your own position" },
      "save": { "$value": "#D93A30", "$type": "color", "$description": "the saved heart" },
      "closed": { "$value": "#C8352C", "$type": "color", "$description": "destructive words and CLOSED, 4.7:1 on paper" },
      "error": { "$value": "#C42B1B", "$type": "color" },
      "errorContainer": { "$value": "#FCE8E6", "$type": "color" },
      "onErrorContainer": { "$value": "#9E2419", "$type": "color" },
      "mint": { "$value": "#D7F0E3", "$type": "color", "$description": "Nature" },
      "sky": { "$value": "#DCEAF5", "$type": "color", "$description": "Museum, Landmark" },
      "butter": { "$value": "#F8EDCF", "$type": "color", "$description": "Church, Heritage" },
      "blush": { "$value": "#F7E0D9", "$type": "color", "$description": "Food" }
    },
    "dark": {
      "page": { "$value": "#262624", "$type": "color", "$description": "warm charcoal, not black" },
      "card": { "$value": "#30302E", "$type": "color" },
      "container": { "$value": "#3A3935", "$type": "color" },
      "containerHigh": { "$value": "#44433F", "$type": "color" },
      "containerHighest": { "$value": "#4E4D48", "$type": "color" },
      "dim": { "$value": "#1F1E1D", "$type": "color" },
      "glass": { "$value": "#262624E0", "$type": "color" },
      "ink": { "$value": "#F2F1EC", "$type": "color", "$description": "13.4:1 on the page" },
      "sub": { "$value": "#ABA9A0", "$type": "color", "$description": "5.6:1 on a card" },
      "outline": { "$value": "#7A7870", "$type": "color" },
      "line": { "$value": "#46453F", "$type": "color" },
      "primary": { "$value": "#3ECF9E", "$type": "color" },
      "onPrimary": { "$value": "#06261C", "$type": "color" },
      "primaryText": { "$value": "#3ECF9E", "$type": "color" },
      "tint": { "$value": "#1E3A30", "$type": "color" },
      "spatial": { "$value": "#7FB2F0", "$type": "color" },
      "save": { "$value": "#F2837A", "$type": "color" },
      "closed": { "$value": "#F2837A", "$type": "color" },
      "error": { "$value": "#F0A5A5", "$type": "color" },
      "errorContainer": { "$value": "#4A1F1F", "$type": "color" },
      "onErrorContainer": { "$value": "#F0A5A5", "$type": "color" },
      "mint": { "$value": "#22392F", "$type": "color" },
      "sky": { "$value": "#1F2F3B", "$type": "color" },
      "butter": { "$value": "#3A3222", "$type": "color" },
      "blush": { "$value": "#3B2A25", "$type": "color" }
    },
    "type": {
      "$comment": "Compact. Cabinet Grotesk for headings, tracking tightening with size; Satoshi for the rest. Colour is applied by the theme. Badges keep type.caps until the last badge goes.",
      "display": { "$type": "typography", "$value": { "fontFamily": "{app.font.heading}", "fontSize": "28sp", "fontWeight": 800, "lineHeight": 1.1, "letterSpacing": "-0.4" }, "$description": "a screen's large title" },
      "hero": { "$type": "typography", "$value": { "fontFamily": "{app.font.heading}", "fontSize": "26sp", "fontWeight": 800, "lineHeight": 1.1, "letterSpacing": "-0.3" }, "$description": "a place's, a town's or a person's name on their own page" },
      "titleLarge": { "$type": "typography", "$value": { "fontFamily": "{app.font.heading}", "fontSize": "20sp", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.2" }, "$description": "a bar or sheet title" },
      "titleMedium": { "$type": "typography", "$value": { "fontFamily": "{app.font.heading}", "fontSize": "17sp", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0" }, "$description": "a section heading, a name on a photo tile" },
      "groupHeading": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "13sp", "fontWeight": 650, "lineHeight": 1.3, "letterSpacing": "0" }, "$description": "the small heading over a settings group" },
      "titleSmall": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "15sp", "fontWeight": 650, "lineHeight": 1.25, "letterSpacing": "0" }, "$description": "a row's or a card's name" },
      "bodyLarge": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "15sp", "fontWeight": 550, "lineHeight": 1.5, "letterSpacing": "0" }, "$description": "reading text" },
      "bodyMedium": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "14sp", "fontWeight": 550, "lineHeight": 1.4, "letterSpacing": "0" } },
      "labelLarge": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "15sp", "fontWeight": 650, "lineHeight": 1.2, "letterSpacing": "0" }, "$description": "buttons and controls" },
      "secondLine": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "13sp", "fontWeight": 550, "lineHeight": 1.3, "letterSpacing": "0" } },
      "labelMedium": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "13sp", "fontWeight": 650, "lineHeight": 1.3, "letterSpacing": "0" }, "$description": "chips, pills, the tab label" },
      "labelSmall": { "$type": "typography", "$value": { "fontFamily": "{app.font.body}", "fontSize": "12sp", "fontWeight": 550, "lineHeight": 1.3, "letterSpacing": "0" }, "$description": "captions" }
    },
    "space": {
      "$comment": "Proximity: 4 to 8 inside a group, 16 between groups. Everything not listed keeps space.*.",
      "section": { "$value": "16dp", "$type": "dimension", "$description": "between sections and between cards" }
    },
    "size": {
      "rowMedia": { "$value": "48dp", "$type": "dimension", "$description": "a row's leading photo" }
    }
  },
  "color": {
    "green": {
      "900": {
        "$value": "#0B3D1F",
        "$type": "color",
        "$description": "deepest — dark surfaces, green text on light"
