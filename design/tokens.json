    }
  },
  "surface": {
    "$comment": "2.0.0. White is the ground. Each step up is a barely visible grey; elevation is the tier you pick, not a shadow you add.",
    "surface": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "the ground (scaffold), bars, chips, fields"
    },
    "dim": {
      "$value": "#E9EBEE",
      "$type": "color"
    },
    "containerLowest": {
