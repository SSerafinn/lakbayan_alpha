{
  "$schema": "https://design-tokens.org/draft",
  "meta": {
    "name": "Lakbayan",
    "description": "Design tokens for Lakbayan — self-guided tourism companion for the Province of Cagayan. Endless Fun, Cagayan: green (nature), blue (water), gold (warmth & wonders).",
    "platform": "Android-first, Flutter / Material 3",
    "version": "1.0.0",
    "source": "Claude Design project 'Lakbayan Design System'. This file is the single source of truth for both apps: lib/core/theme/*.dart transcribes it, cms/src/styles/tokens.css is generated from it by cms/scripts/gen-tokens.mjs. Change it here first."
  },
  "color": {
    "green": {
      "900": { "$value": "#0E2E1B", "$type": "color", "$description": "deepest — dark surfaces, green text on light" },
      "700": { "$value": "#123D24", "$type": "color", "$description": "deep forest — headers, pressed states" },
      "500": { "$value": "#1E7A3E", "$type": "color", "$description": "BASE — primary actions, nav, brand" },
      "300": { "$value": "#5AA575", "$type": "color", "$description": "lighter — illustrations, hover" },
      "100": { "$value": "#DCEBE0", "$type": "color", "$description": "tint — selected / section fill" },
      "50":  { "$value": "#EFF6EF", "$type": "color", "$description": "subtle background" }
    },
    "blue": {
      "700": { "$value": "#0C4A7C", "$type": "color" },
      "500": { "$value": "#115E9C", "$type": "color", "$description": "BASE — secondary actions, links, map" },
      "300": { "$value": "#4E90C6", "$type": "color" },
      "100": { "$value": "#DDEAF5", "$type": "color" },
      "50":  { "$value": "#E9F1FA", "$type": "color" }
    },
    "gold": {
      "700": { "$value": "#B87A08", "$type": "color", "$description": "gold TEXT / icons on light" },
      "500": { "$value": "#E29A0C", "$type": "color", "$description": "BASE — accent fills, highlights" },
      "300": { "$value": "#F4C765", "$type": "color" },
      "100": { "$value": "#FBEFD2", "$type": "color" }
    },
    "ink": {
      "900": { "$value": "#1E2733", "$type": "color", "$description": "headings" },
      "700": { "$value": "#2C3A4B", "$type": "color", "$description": "body text" }
    },
    "slate": {
      "500": { "$value": "#6A7683", "$type": "color", "$description": "secondary text" },
      "300": { "$value": "#9AA6B2", "$type": "color", "$description": "placeholder / disabled" }
    },
    "line":       { "$value": "#D9E4DA", "$type": "color", "$description": "borders / dividers" },
    "surface":    { "$value": "#FFFFFF", "$type": "color", "$description": "cards" },
    "background": { "$value": "#F6F9F6", "$type": "color", "$description": "app background (faint green tint)" }
  },
  "semantic": {
    "success": { "$value": "{color.green.500}", "$type": "color" },
    "warning": { "$value": "{color.gold.500}", "$type": "color" },
    "error":   { "$value": "#D14343", "$type": "color" },
    "info":    { "$value": "{color.blue.500}", "$type": "color" },
    "primary":            { "$value": "{color.green.500}", "$type": "color" },
    "onPrimary":          { "$value": "#FFFFFF", "$type": "color" },
    "primaryPressed":     { "$value": "{color.green.700}", "$type": "color" },
    "primaryContainer":   { "$value": "{color.green.100}", "$type": "color" },
    "onPrimaryContainer": { "$value": "{color.green.700}", "$type": "color" },
    "secondary":          { "$value": "{color.blue.500}", "$type": "color" },
    "onSecondary":        { "$value": "#FFFFFF", "$type": "color" },
    "accent":             { "$value": "{color.gold.500}", "$type": "color" },
    "onAccent":           { "$value": "{color.ink.900}", "$type": "color" },
    "textHeading":        { "$value": "{color.ink.900}", "$type": "color" },
    "textBody":           { "$value": "{color.ink.700}", "$type": "color" },
    "textSecondary":      { "$value": "{color.slate.500}", "$type": "color" },
    "textDisabled":       { "$value": "{color.slate.300}", "$type": "color" },
    "textOnLightGreen":   { "$value": "{color.green.700}", "$type": "color", "$description": "green text on white must be /700 or /900 for AA" },
    "link":               { "$value": "{color.blue.500}", "$type": "color" }
  },
  "dark": {
    "$description": "optional, v2",
    "background": { "$value": "#10201A", "$type": "color" },
    "surface":    { "$value": "#0E2E1B", "$type": "color" },
    "text":       { "$value": "#EAF2EC", "$type": "color" },
    "primary":    { "$value": "{color.green.300}", "$type": "color" },
    "secondary":  { "$value": "{color.blue.300}", "$type": "color" }
  },
  "font": {
    "family": {
      "heading": { "$value": "Plus Jakarta Sans", "$type": "fontFamily", "$description": "weights 600, 700" },
      "body":    { "$value": "Inter", "$type": "fontFamily", "$description": "weights 400, 500, 600" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    }
  },
  "typography": {
    "display":  { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontSize": "36sp", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "0" }, "$description": "range 32–40" },
    "h1":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontSize": "28sp", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "0" } },
    "h2":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontSize": "22sp", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "0" } },
    "h3":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontSize": "18sp", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "0" } },
    "title":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "16sp", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "0" } },
    "bodyLarge":{ "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "16sp", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } },
    "body":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "14sp", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } },
    "label":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "14sp", "fontWeight": 600, "lineHeight": 1.2, "letterSpacing": "0.3" } },
    "caption":  { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "12sp", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": "0" } },
    "overline": { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "12sp", "fontWeight": 600, "lineHeight": 1.4, "letterSpacing": "1.2", "textCase": "uppercase" } }
  },
  "radius": {
    "sm":   { "$value": "8dp",  "$type": "dimension" },
    "md":   { "$value": "12dp", "$type": "dimension", "$description": "cards, inputs, chips-large" },
    "lg":   { "$value": "16dp", "$type": "dimension", "$description": "cards, sheets" },
    "pill": { "$value": "999dp","$type": "dimension", "$description": "chips, buttons" }
  },
  "space": {
    "1": { "$value": "4dp",  "$type": "dimension" },
    "2": { "$value": "8dp",  "$type": "dimension" },
    "3": { "$value": "12dp", "$type": "dimension" },
    "4": { "$value": "16dp", "$type": "dimension" },
    "5": { "$value": "20dp", "$type": "dimension" },
    "6": { "$value": "24dp", "$type": "dimension" },
    "8": { "$value": "32dp", "$type": "dimension" }
  },
  "elevation": {
    "card":  { "$value": "0 1px 3px rgba(30,39,51,0.08), 0 1px 2px rgba(30,39,51,0.04)", "$type": "shadow" },
    "raised":{ "$value": "0 4px 14px rgba(18,61,36,0.10)", "$type": "shadow" },
    "nav":   { "$value": "0 -1px 8px rgba(30,39,51,0.06)", "$type": "shadow" }
  },
  "size": {
    "minTouchTarget": { "$value": "48dp", "$type": "dimension" },
    "appBarHeight":   { "$value": "56dp", "$type": "dimension" },
    "bottomNav":      { "$value": "64dp", "$type": "dimension" }
  }
}
