    "earth": {
      "700": {
        "$value": "#A4620D",
        "$type": "color",
        "$description": "the Heritage category glyph on Home. A glyph colour, never a fill."
      }
    },
    "ink": {
      "900": {
        "$value": "#121212",
        "$type": "color",
