{
  "indexes": [
    {
      "__comment": "Browse: all published, alphabetical. Equality on status plus an orderBy on a different field needs its own composite - the single-field indexes Firestore creates automatically are not enough.",
      "collectionGroup": "destinations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Browse by category. Every public query must filter on status, because firestore.rules gates reads on it - an unfiltered query is denied wholesale rather than partially.",
      "collectionGroup": "destinations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "category", "order": "ASCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Browse by municipality, and the per-town listing an offline bundle is built from.",
      "collectionGroup": "destinations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "town", "order": "ASCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Explore: the featured rail.",
      "collectionGroup": "destinations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "featured", "order": "DESCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Explore: the popular rail.",
      "collectionGroup": "destinations",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "popular", "order": "DESCENDING" },
        { "fieldPath": "name", "order": "ASCENDING" }
      ]
    },
    {
      "__comment": "Audio guide player: segments in sequence. Collection group so a segment can be resolved without knowing its parent - the offline bundle builder needs that.",
      "collectionGroup": "segments",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "order", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
