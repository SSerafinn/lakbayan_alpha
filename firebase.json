{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "cms",
      "public": "cms/dist",
      "ignore": ["**/.*"],
      "predeploy": [
        "npm --prefix cms run build",
        "node cms/scripts/check-dist.mjs"
      ],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
            { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" },
            { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com https://tile.openstreetmap.org; media-src 'self' blob: https://firebasestorage.googleapis.com; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://nominatim.openstreetmap.org; worker-src 'self' blob:" }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "**/!(*.*)",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        },
        {
          "source": "/index.html",
          "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "src", "*.log"]
    }
  ],
  "emulators": {
    "auth": { "port": 9099, "host": "0.0.0.0" },
    "firestore": { "port": 8080, "host": "0.0.0.0" },
    "functions": { "port": 5001, "host": "0.0.0.0" },
    "storage": { "port": 9199, "host": "0.0.0.0" },
    "hosting": { "port": 5050 },
    "hub": { "port": 4400, "host": "0.0.0.0" },
    "logging": { "port": 4500, "host": "0.0.0.0" },
    "ui": { "enabled": true, "port": 4000, "host": "0.0.0.0" },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "project-lakbayan",
          "appId": "1:3422515105:android:bf948131f4052ca8c225e0",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "project-lakbayan",
          "configurations": {
            "android": "1:3422515105:android:bf948131f4052ca8c225e0",
            "web": "1:3422515105:web:58805326239b43adc225e0"
          }
        }
      }
    }
  }
}
