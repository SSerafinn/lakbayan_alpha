# Normalize to LF in the working tree. All three devs are on Windows, but the
# same files are mounted into Linux containers — a CRLF shell script or gradlew
# fails there with an unreadable "bad interpreter" error.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly LF regardless of the above.
*.sh       text eol=lf
*.dart     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
gradlew    text eol=lf
Dockerfile text eol=lf

# Binary — never touch.
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.jar      binary
*.keystore binary
*.jks      binary
*.mp3      binary
*.mbtiles  binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
