{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter *)",
      "Bash(dart *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(firebase emulators:*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(firebase deploy*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/serviceAccount*.json)"
    ]
  }
}
