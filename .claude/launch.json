{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lakbayan-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "8088",
        "--dart-define-from-file=config/dev.json"
      ],
      "port": 8088
    },
    {
      "name": "lakbayan-cms",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "cms", "run", "dev"],
      "port": 5173
    }
  ]
}
