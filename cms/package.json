{
  "name": "lakbayan-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Admin CMS for Lakbayan. Consumes the Firestore schema owned by the repo root — see docs/DATA_MODEL.md.",
  "scripts": {
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "dev": "npm run gen:tokens && vite",
    "build": "npm run gen:tokens && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^1.37.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}
