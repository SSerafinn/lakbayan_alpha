# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.lock

# generated (regenerate with build_runner)
# (keep generated files out of VCS; regenerate on checkout)
*.g.dart
*.freezed.dart

# IDE
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Claude Code machine-local overrides (shared config lives in settings.json)
.claude/settings.local.json

# Secrets / config — NEVER commit
.env
*.env
ios/Runner/GoogleService-Info.plist
**/serviceAccount*.json

# NOT ignored, deliberately: android/app/google-services.json and
# lib/firebase_options.dart for the DEV project (project-lakbayan).
#
# These are not secrets. Firebase Android and Web API keys are public
# identifiers — every shipped APK contains them, and anyone can extract them in
# minutes. Access is controlled by firestore.rules, storage.rules and App Check,
# not by keeping the key hidden. Google documents this explicitly.
#
# They must be committed because the `com.google.gms.google-services` Gradle
# plugin reads google-services.json at BUILD time: without it, CI and every
# teammate fail with "File google-services.json is missing".
#
# A production Firebase project is a different matter — keep its config out of
# the repo and inject it in CI. See docs/DECISIONS.md D-08.

# Node side-projects: rules tests and operational scripts
test_rules/node_modules/
test_rules/package-lock.json
scripts/node_modules/
functions/node_modules/
# Installed inside docker/tiles — the renderer's binaries are Linux-only, so a
# host install would not work anyway.
tools/tiles/node_modules/
# Offline map packs, and everything the tile pipeline writes beside them.
# Regenerable, and a single town pack is several MB.
#
# Anchored with a leading slash. Without it the pattern matches a directory
# named `tiles` at ANY depth, which silently swallowed both `docker/tiles/` and
# `tools/tiles/` — the pipeline itself — and they simply never appeared in
# `git status`.
/tiles/
# tsc output; the emulator container rebuilds it on every start.
functions/lib/
scripts/package-lock.json

# Per-developer run config (LAN IP for testing on a physical device).
# config/dev.json is shared and committed; this one is yours.
config/local.json

# Docker / local backend
# Emulator state is per-developer scratch. To share a seed, export it
# deliberately and commit it under a named folder — see docs/DOCKER.md.
.emulator-data/
artifacts/

# Office lock files. Excel writes ~$Book.xlsx beside a workbook while it is
# open and deletes it on close, so it only ever appears mid-edit — which is
# exactly when someone is most likely to `git add` the intake folder.
~$*

# misc
*.log
.DS_Store

# Firebase CLI deploy cache
.firebase/
