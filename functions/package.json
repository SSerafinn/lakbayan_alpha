{
  "name": "lakbayan-functions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloud Functions for Lakbayan. Callables the CMS uses for things a browser must never be allowed to do directly — see docs/DECISIONS.md D-12.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "test": "npm run build && node --test \"lib/**/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
