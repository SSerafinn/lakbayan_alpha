# Keep the build context small — the images only need pubspec + rules files.
.git
.dart_tool
.idea
.vscode
build
artifacts
.emulator-data
android/.gradle
android/app/build
**/*.g.dart
**/*.freezed.dart
*.log
.env

# Sibling apps and Node tooling — the Flutter toolchain image needs none of it.
cms
functions
test_rules
scripts/node_modules
**/google-services.json
**/serviceAccount*.json
lib/firebase_options.dart
